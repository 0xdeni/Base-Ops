# Base mainnet JSON-RPC endpoint. Any standard endpoint works; a paid one is recommended
# for full-coverage snapshots (tick-bitmap walks are multicall heavy).
DEPTHWATCH_RPC_URL=https://mainnet.base.org

# Endpoint for eth_getLogs only (discover, volume, positions); defaults to DEPTHWATCH_RPC_URL.
# Use it when the main endpoint is a plan that caps log ranges (Alchemy's free tier: 10 blocks)
# and another endpoint accepts wide ranges. Both URLs are http(s). URLs may carry API keys: they
# are never logged, and error messages keep only a URL's origin.
# DEPTHWATCH_LOGS_RPC_URL=https://mainnet.base.org

# Blocks per eth_getLogs request (default 2000, what Base's public RPC accepts). Keep the default
# here: on a plan that caps log ranges, set the cap per command, for small scans only, e.g.
# `DEPTHWATCH_LOG_CHUNK=10 depthwatch volume` (Alchemy free). Set globally, a plain `discover`
# would scan from the factories' deployment blocks in 10-block requests, about 5 M per factory;
# discover with `depthwatch discover --seed` instead, which reads factory views, not logs.
# DEPTHWATCH_LOG_CHUNK=2000

# SQLite database file. Created on first run.
DEPTHWATCH_DB=./depthwatch.db

# API/web server port.
DEPTHWATCH_PORT=8787

# Number of pools (ranked by TVL) to take full depth snapshots of.
DEPTHWATCH_TOP_POOLS=200

# Public base URL of this deployment, used for the scorecard links `mm register` prints and the
# `scorecardUrl` of webhook alerts. Defaults to http://<host>:<port> of `serve`.
# DEPTHWATCH_PUBLIC_URL=https://depthwatch.example

# Bearer token that `POST /api/mm` and `DELETE /api/mm/:id` require (serve and demo). Environment
# only, no flag. Unset, those routes answer 403 and mandates are registered with `mm register`.
# DEPTHWATCH_ADMIN_TOKEN=change-me
